{
  "name": "design-gate",
  "version": "1.1.2",
  "description": "Deterministic structural gate for generated HTML. Accessibility heuristics, not a certification.",
  "type": "module",
  "bin": {
    "design-gate": "design-gate.mjs"
  },
  "scripts": {
    "test": "node --test design-gate.test.mjs",
    "verify": "node --check design-gate.mjs && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "parse5": "^7.3.0"
  },
  "keywords": [
    "html",
    "accessibility",
    "lint",
    "ci",
    "design"
  ],
  "license": "MIT",
  "files": [
    "design-gate.mjs",
    "examples/",
    "demo/",
    "SECURITY.md",
    "LICENSE"
  ]
}
